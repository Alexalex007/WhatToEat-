rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 12 && code.matches('^[A-Z0-9]{6,12}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBoardMember(boardId) {
      return isSignedIn() && exists(/databases/$(database)/documents/boards/$(boardId)/members/$(request.auth.uid));
    }

    function isBoardOwner(boardId) {
      return isSignedIn() && get(/databases/$(database)/documents/boards/$(boardId)).data.ownerId == request.auth.uid;
    }

    function isValidFoodList(listData) {
      return listData is list && listData.size() <= 30 && (
        listData.size() == 0 || (listData[0] is string && listData[0].size() >= 1 && listData[0].size() <= 40)
      );
    }

    function isValidMoodList(listData) {
      return listData is list && listData.size() <= 10 && (
        listData.size() == 0 || (listData[0] is string && listData[0].size() >= 1 && listData[0].size() <= 40)
      );
    }

    function isValidBreakdownList(listData) {
      return listData is list && listData.size() <= 20 && (
        listData.size() == 0 || (listData[0] is string && listData[0].size() >= 1 && listData[0].size() <= 240)
      );
    }

    function isValidPriceTier(tier) {
      return tier in ['$', '$$', '$$$', '$$$$'];
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'favoriteFoods', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'favoriteFoods', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.email is string && data.email.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 500
        && isValidFoodList(data.favoriteFoods)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoard(data) {
      return data.keys().hasAll(['id', 'name', 'description', 'ownerId', 'inviteCode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'description', 'ownerId', 'inviteCode', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.description is string && data.description.size() <= 160
        && isValidId(data.ownerId)
        && isValidInviteCode(data.inviteCode)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['inviteCode', 'boardId', 'boardName', 'ownerId', 'createdAt'])
        && data.keys().hasOnly(['inviteCode', 'boardId', 'boardName', 'ownerId', 'createdAt'])
        && isValidInviteCode(data.inviteCode)
        && isValidId(data.boardId)
        && data.boardName is string && data.boardName.size() >= 1 && data.boardName.size() <= 60
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidBoardMember(data) {
      return data.keys().hasAll([
          'uid', 'boardId', 'boardName', 'displayName', 'photoURL', 'role',
          'favoriteFoods', 'todayFoods', 'moodFilters', 'budgetMax', 'maxWalkKm', 'status',
          'inviteCode', 'joinedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'boardId', 'boardName', 'displayName', 'photoURL', 'role',
          'favoriteFoods', 'todayFoods', 'moodFilters', 'budgetMax', 'maxWalkKm', 'status',
          'inviteCode', 'joinedAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && isValidId(data.boardId)
        && data.boardName is string && data.boardName.size() >= 1 && data.boardName.size() <= 60
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.role in ['owner', 'editor']
        && isValidFoodList(data.favoriteFoods)
        && isValidFoodList(data.todayFoods)
        && isValidMoodList(data.moodFilters)
        && isValidPriceTier(data.budgetMax)
        && data.maxWalkKm is number && data.maxWalkKm >= 1 && data.maxWalkKm <= 5
        && data.status in ['picking', 'ready']
        && isValidInviteCode(data.inviteCode)
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomSession(data) {
      return data.keys().hasAll([
          'id', 'boardId', 'spinCount', 'lastWinner', 'rejectedFoods', 'weightMode',
          'finalSearchKeyword', 'aiFinalPick', 'aiSummaryTone', 'aiMemberBreakdown',
          'aiBackupName', 'aiBackupKeyword', 'aiBackupReason', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'boardId', 'spinCount', 'lastWinner', 'rejectedFoods', 'weightMode',
          'finalSearchKeyword', 'aiFinalPick', 'aiSummaryTone', 'aiMemberBreakdown',
          'aiBackupName', 'aiBackupKeyword', 'aiBackupReason', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.boardId)
        && data.spinCount is number && data.spinCount >= 0 && data.spinCount <= 1000
        && data.lastWinner is string && data.lastWinner.size() <= 60
        && isValidFoodList(data.rejectedFoods)
        && data.weightMode in ['weighted', 'equal']
        && data.finalSearchKeyword is string && data.finalSearchKeyword.size() <= 80
        && data.aiFinalPick is string && data.aiFinalPick.size() <= 60
        && data.aiSummaryTone is string && data.aiSummaryTone.size() <= 400
        && isValidBreakdownList(data.aiMemberBreakdown)
        && data.aiBackupName is string && data.aiBackupName.size() <= 60
        && data.aiBackupKeyword is string && data.aiBackupKeyword.size() <= 80
        && data.aiBackupReason is string && data.aiBackupReason.size() <= 300
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 60
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Private User Profiles (PII isolated to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'favoriteFoods', 'updatedAt']);
    }

    // 2. Invite Lookup Directory (Get by exact 6-digit code only, no listing)
    match /invites/{inviteCode} {
      allow get: if isSignedIn() && isValidInviteCode(inviteCode);
      allow create: if isSignedIn() && isValidInviteCode(inviteCode)
        && isValidInvite(incoming())
        && incoming().inviteCode == inviteCode
        && incoming().createdAt == request.time
        && getAfter(/databases/$(database)/documents/boards/$(incoming().boardId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/boards/$(incoming().boardId)).data.inviteCode == inviteCode;
      allow update: if isSignedIn() && isValidInviteCode(inviteCode)
        && isValidInvite(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().inviteCode == existing().inviteCode
        && incoming().boardId == existing().boardId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['boardName']);
      allow delete: if isSignedIn() && isValidInviteCode(inviteCode) && existing().ownerId == request.auth.uid;
    }

    // 3. CollectionGroup query for user's own room memberships
    match /{path=**}/members/{memberId} {
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // 4. Shared Group Dining Rooms
    match /boards/{boardId} {
      allow get: if isValidId(boardId) && isBoardMember(boardId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(boardId) && isSignedIn()
        && isValidBoard(incoming())
        && incoming().id == boardId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/boards/$(boardId)/members/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/invites/$(incoming().inviteCode));
      allow update: if isValidId(boardId) && isSignedIn()
        && isValidBoard(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().inviteCode == existing().inviteCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt']);
      allow delete: if isValidId(boardId) && isSignedIn() && existing().ownerId == request.auth.uid;

      // 4a. Room Members
      match /members/{memberId} {
        allow get: if isValidId(boardId) && isValidId(memberId) && ((isSignedIn() && memberId == request.auth.uid) || isBoardMember(boardId));
        allow list: if isBoardMember(boardId);
        allow create: if isSignedIn() && isValidId(boardId) && isValidId(memberId)
          && memberId == request.auth.uid
          && isValidBoardMember(incoming())
          && incoming().uid == request.auth.uid
          && incoming().boardId == boardId
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && (
            (incoming().role == 'owner' && getAfter(/databases/$(database)/documents/boards/$(boardId)).data.ownerId == request.auth.uid)
            || (incoming().role == 'editor'
                && exists(/databases/$(database)/documents/invites/$(incoming().inviteCode))
                && get(/databases/$(database)/documents/invites/$(incoming().inviteCode)).data.boardId == boardId)
          );
        allow update: if isSignedIn() && isValidId(boardId) && isValidId(memberId)
          && memberId == request.auth.uid
          && isValidBoardMember(incoming())
          && incoming().uid == existing().uid
          && incoming().boardId == existing().boardId
          && incoming().role == existing().role
          && incoming().inviteCode == existing().inviteCode
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'favoriteFoods', 'todayFoods',
            'moodFilters', 'budgetMax', 'maxWalkKm', 'status', 'boardName', 'updatedAt'
          ]);
        allow delete: if isSignedIn() && isValidId(boardId) && isValidId(memberId)
          && ((memberId == request.auth.uid && existing().role != 'owner') || isBoardOwner(boardId));
      }

      // 4b. Synchronized Room Session (Roulette + AI Rescue)
      match /sessions/{sessionId} {
        allow get: if isValidId(boardId) && isValidId(sessionId) && isBoardMember(boardId);
        allow list: if isBoardMember(boardId);
        allow create: if isSignedIn() && isValidId(boardId) && isValidId(sessionId)
          && sessionId == 'current'
          && isBoardMember(boardId)
          && isValidRoomSession(incoming())
          && incoming().id == sessionId
          && incoming().boardId == boardId
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn() && isValidId(boardId) && isValidId(sessionId)
          && sessionId == 'current'
          && isBoardMember(boardId)
          && isValidRoomSession(incoming())
          && incoming().id == existing().id
          && incoming().boardId == existing().boardId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'spinCount', 'lastWinner', 'rejectedFoods', 'weightMode',
            'finalSearchKeyword', 'aiFinalPick', 'aiSummaryTone', 'aiMemberBreakdown',
            'aiBackupName', 'aiBackupKeyword', 'aiBackupReason', 'updatedBy', 'updatedByName', 'updatedAt'
          ]);
        allow delete: if isSignedIn() && isValidId(boardId) && isBoardOwner(boardId);
      }
    }
  }
}
