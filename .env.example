# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API Key.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_FIREBASE_CONFIG: Optional JSON string override for Firebase web config.
VITE_FIREBASE_CONFIG=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
